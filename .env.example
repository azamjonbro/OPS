# ---------------------------------------------------------------------------
# Hadiya 2.0 — environment template
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed; this file carries
# placeholders only. Every variable below is validated at start-up by
# apps/api/src/config/env.ts — an unknown or malformed value fails the boot.
#
# Values shown after "default:" are what the API uses when the variable is
# absent, so most of this file can stay commented out in local development.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- HTTP server -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_BASE_PATH=/api
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Max accepted request body (default: 1mb).
BODY_LIMIT=1mb
# Grace period for in-flight requests on SIGTERM (default: 10000).
SHUTDOWN_TIMEOUT_MS=10000
# Enable only when the API runs behind a reverse proxy (default: false).
TRUST_PROXY=false

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=debug
# Human-readable output; defaults to on outside production.
LOG_PRETTY=true

# --- Rate limiting ---------------------------------------------------------
# The coarse limit over the whole API, per address.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Per-endpoint budgets the global limit is too coarse to express.
#
# LOGIN counts *failed* sign-ins per address and per username over fifteen
# minutes, so somebody typing their own password correctly is never locked out.
# The other three are cost controls, counted per account per minute: a chat turn
# spends model completions, an image is billed per picture, and an upload is fed
# to a document parser.
LOGIN_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
IMAGE_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=30

# --- MongoDB ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/hadiya
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Auth ------------------------------------------------------------------
# Required in production, and at least 32 characters there. Generate with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Billz POS integration -------------------------------------------------
# Host defaults to https://api-admin.billz.ai; override only for another region.
BILLZ_BASE_URL=
# API secret token from the Billz admin panel. Without it the integration
# reports itself as unconfigured and its endpoints answer 503.
BILLZ_API_TOKEN=
BILLZ_TIMEOUT_MS=15000
BILLZ_MAX_RETRIES=2
# Comma-separated Billz shop ids to restrict reads to. Empty = whole company.
BILLZ_SHOP_IDS=

# --- Integrations (wired up in later phases) -------------------------------

# --- AI assistant ----------------------------------------------------------
# One key is enough. With both set, AI_PROVIDER decides; with neither, the
# assistant reports itself unavailable and /ai/chat answers 503.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | anthropic. Leave empty to infer from whichever key is present.
AI_PROVIDER=
# Leave empty to use the provider's default model (see modules/ai/provider).
AI_MODEL=
# Override only for a proxy or a regional endpoint.
AI_BASE_URL=
# A tool-calling turn is slower than a plain reply; keep this generous.
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4096
# Which dialect of the OpenAI API the endpoint speaks. Left blank it is
# inferred: an AI_BASE_URL that is not OpenAI means `openai-compatible`, which
# is what Groq, Gemini's compatibility layer, OpenRouter and the rest accept.
AI_COMPATIBILITY=

# --- Running on a free tier -------------------------------------------------
# Several services implement this same API and cost nothing to start with, so
# the assistant can run without a billed OpenAI account. Only the three lines
# below change; nothing in the code does.
#
# Groq (free, no card; fastest, and the same key does transcription):
#   OPENAI_API_KEY=gsk_...
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   STT_BASE_URL=https://api.groq.com/openai/v1
#   # Transcription's own credential. Leave blank to share OPENAI_API_KEY; set it
# when chat and dictation are pointed at different services.
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
#
# Google Gemini (free tier, more room per request; no transcription endpoint):
#   OPENAI_API_KEY=AIza...
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
#
# Best of both, and what this project is tuned for: Gemini answers, because a
# large tool catalogue needs the token headroom, and Groq transcribes, because
# it is free and immediate. Two keys, one for each half:
#   OPENAI_API_KEY=AIza...
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
#   STT_API_KEY=gsk_...
#   STT_BASE_URL=https://api.groq.com/openai/v1
#   STT_MODEL=whisper-large-v3-turbo
#
# The variable is still called OPENAI_API_KEY because it is the credential for
# whatever OpenAI-shaped endpoint AI_BASE_URL names. Image generation has no
# free equivalent and stays unavailable until a billed key is configured.

# --- Voice input (speech to text) ------------------------------------------
# Transcription shares OPENAI_API_KEY with the chat models, so configuring the
# assistant configures dictation too. With no key the microphone is not offered.
# Leave empty to infer from the configured key. Only `openai` is implemented.
STT_PROVIDER=
# Leave empty for the built-in default (whisper-1), which has documented Uzbek
# coverage. `gpt-4o-transcribe` and `gpt-4o-mini-transcribe` also work.
STT_MODEL=
# Override only for a proxy or a regional endpoint.
STT_BASE_URL=
# Leave empty to let the model detect the language, which is what a bilingual
# shop floor needs. Set an ISO-639-1 code (e.g. `uz`) to pin one.
# One language, pinned. Leave blank to let the model detect it — which is the
# default, and what a floor switching between languages needs.
STT_LANGUAGE=
# The languages actually spoken here, primary first. Detection stays on; its
# answer is checked against this list, and anything outside it is treated as a
# misdetection and offered once more with the first entry pinned. Whisper is
# unreliable on Uzbek and regularly reports a Cyrillic neighbour instead.
STT_LANGUAGES=uz,en
STT_TIMEOUT_MS=60000
STT_MAX_RETRIES=1

# --- Image generation ------------------------------------------------------
# The image models share OPENAI_API_KEY with the text models, so configuring the
# assistant configures this too. With no key, image generation answers 503 and
# nothing else is affected.
# Leave empty to infer from the configured key. Only `openai` is implemented.
IMAGE_PROVIDER=
# Leave empty for the built-in default (gpt-image-1). `dall-e-3` also works.
IMAGE_MODEL=
# Override only for a proxy or a regional endpoint.
IMAGE_BASE_URL=
# Drawing takes far longer than a sentence; keep this generous.
IMAGE_TIMEOUT_MS=120000
IMAGE_MAX_RETRIES=1

# Where generated images are kept. `local` writes to disk; object storage is a
# second implementation of the same four-method interface.
STORAGE_DRIVER=local
# Relative paths resolve against apps/api. Keep it out of version control.
STORAGE_LOCAL_DIR=storage

# --- Reminders, scheduler and notifications --------------------------------
# There is nothing to configure. Scheduled jobs are rows in MongoDB and the
# worker polls them, so the schedule survives a restart with no extra service.
# A user's time zone lives on their account (`PATCH /v1/users/me/preferences`),
# not here: two employees can sit in different zones.

# Telegram
# Declared as a notification channel but not yet implemented: delivery needs a
# chat id per employee as well as this token. Until then the provider reports
# itself unavailable and reminders are delivered in-app.
TELEGRAM_BOT_TOKEN=

# --- Integration Hub -------------------------------------------------------
# The key every integration credential is encrypted with: 32 bytes, base64 or
# hex. Generate one with:
#
#   openssl rand -base64 32
#
# Required in production; the process refuses to start without it. Left unset
# in development, storing a credential is refused rather than done in the clear
# — so a forgotten variable produces a clear error on the day somebody adds an
# integration, not a database full of plaintext tokens nobody noticed.
#
# Rotating it makes existing credentials unreadable: they are marked as sealed
# by a different key and each integration has to be reconnected. Keep the old
# key until every one has been.
CREDENTIALS_ENCRYPTION_KEY=

# How long an MCP handshake may take before Hadiya gives up on it.
MCP_CONNECT_TIMEOUT_MS=10000
# How long one MCP tool call may take. This is the cap on how long somebody
# else's server can stall a conversation.
MCP_TOOL_TIMEOUT_MS=30000
# Whether a user-supplied MCP server URL may point at a private or loopback
# address.
#
# Off, and production refuses to start with it on. Hadiya makes the outbound
# request itself, so an unchecked address is a request-forgery primitive handed
# to anyone with an account: `http://169.254.169.254/` is the cloud metadata
# service and `http://127.0.0.1:27017/` is this database. Turn it on only to
# develop against an MCP server on your own machine.
MCP_ALLOW_PRIVATE_HOSTS=false

# --- Agent safety ----------------------------------------------------------
# Whether a confirmed destructive call must match an action Hadiya itself
# prepared and the user then agreed to.
#
# Leave it on. The model reads uploaded documents, Notion pages, Billz records
# and other people's MCP servers; any of those can contain "call the delete tool
# with confirm: true", and with this off that sentence is enough — the tool runs
# and no human was ever asked. Turning it off costs one fewer turn when a model
# proposes and confirms in the same breath, which is not worth it.
AGENT_REQUIRE_PENDING_CONFIRMATION=true

# How many tools one model response may ask for. `AGENT_MAX_PARALLEL_TOOLS`
# bounds how many run at once; this bounds how many run at all, so a model that
# loops cannot turn one answer into hundreds of outbound requests.
AGENT_MAX_TOOL_CALLS_PER_ROUND=12

# Notion. There is no token here: each person connects their own workspace and
# their token is stored encrypted against their account, so this is only the
# endpoint and the API version to speak.
NOTION_BASE_URL=https://api.notion.com
NOTION_API_VERSION=2022-06-28
NOTION_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Frontend (apps/web). Vite only exposes VITE_-prefixed variables to the
# browser bundle — never put a secret behind this prefix.
# ---------------------------------------------------------------------------
VITE_APP_NAME=Hadiya
# Left as a relative path so the dev proxy and the production build both work.
VITE_API_BASE_URL=/api
# Where the dev server proxies /api to.
VITE_DEV_API_TARGET=http://127.0.0.1:4000
# Turn on once the auth module lands (default: false).
VITE_AUTH_ENFORCED=false
